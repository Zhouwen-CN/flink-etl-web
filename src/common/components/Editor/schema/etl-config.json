{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/example/flink-etl-tool/job-config.json",
  "title": "Flink ETL Job Config",
  "description": "Apache Flink 配置驱动 ETL 任务的 JSON 配置文件",
  "type": "object",
  "required": [
    "sources",
    "sinks"
  ],
  "properties": {
    "job": {
      "$ref": "#/definitions/JobConfig"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/SourcePlugin"
      }
    },
    "transforms": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TransformPlugin"
      }
    },
    "sinks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/SinkPlugin"
      }
    }
  },
  "definitions": {
    "JobConfig": {
      "type": "object",
      "required": [
        "name",
        "mode"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "batch",
            "streaming"
          ]
        },
        "parallelism": {
          "type": "integer",
          "minimum": 1
        },
        "checkpointInterval": {
          "type": "integer",
          "minimum": 1000
        },
        "checkpointTimeout": {
          "type": "integer",
          "minimum": 1000
        }
      },
      "additionalProperties": false
    },
    "SimpleType": {
      "type": "string",
      "enum": [
        "string",
        "STRING",
        "boolean",
        "BOOLEAN",
        "int",
        "INT",
        "long",
        "LONG",
        "double",
        "DOUBLE",
        "decimal",
        "DECIMAL",
        "timestamp",
        "TIMESTAMP"
      ]
    },
    "FieldSchema": {
      "description": "Schema 字段定义：简单类型、基础类型数组、嵌套对象或对象数组",
      "oneOf": [
        {
          "$ref": "#/definitions/SimpleType"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SimpleType"
          },
          "minItems": 1,
          "maxItems": 1
        },
        {
          "$ref": "#/definitions/ObjectSchema"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ObjectSchema"
          },
          "minItems": 1,
          "maxItems": 1
        }
      ]
    },
    "ObjectSchema": {
      "description": "嵌套对象 Schema 定义",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/FieldSchema"
      }
    },
    "SchemaDefinition": {
      "description": "Schema 顶层定义",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/FieldSchema"
      }
    },
    "JdbcSource": {
      "type": "object",
      "required": [
        "type",
        "outputTable",
        "config"
      ],
      "properties": {
        "type": {
          "const": "jdbc"
        },
        "outputTable": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "url",
            "username",
            "password"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "dialect": {
              "type": "string",
              "enum": [
                "mysql",
                "postgresql",
                "oracle"
              ]
            },
            "table": {
              "type": "string"
            },
            "sql": {
              "type": "string"
            },
            "splitKey": {
              "type": "string"
            },
            "batchSize": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            },
            "queryTimeout": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "LocalFileSource": {
      "type": "object",
      "required": [
        "type",
        "outputTable",
        "config"
      ],
      "properties": {
        "type": {
          "const": "localfile"
        },
        "outputTable": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "path",
            "format",
            "schema"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "format": {
              "type": "string",
              "enum": [
                "csv"
              ]
            },
            "encoding": {
              "type": "string"
            },
            "delimiter": {
              "type": "string"
            },
            "skipHeader": {
              "type": "boolean"
            },
            "recursive": {
              "type": "boolean"
            },
            "schema": {
              "$ref": "#/definitions/SchemaDefinition"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "HttpSource": {
      "type": "object",
      "required": [
        "type",
        "outputTable",
        "config"
      ],
      "properties": {
        "type": {
          "const": "http"
        },
        "outputTable": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "url",
            "schema"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "method": {
              "type": "string",
              "enum": [
                "get",
                "GET",
                "post",
                "POST"
              ]
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "params": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": {},
            "format": {
              "type": "string",
              "enum": [
                "json",
                "xml"
              ]
            },
            "jsonPath": {
              "type": "string"
            },
            "xmlPath": {
              "type": "string"
            },
            "schema": {
              "$ref": "#/definitions/SchemaDefinition"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "KafkaSource": {
      "type": "object",
      "required": [
        "type",
        "outputTable",
        "config"
      ],
      "properties": {
        "type": {
          "const": "kafka"
        },
        "outputTable": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "bootstrapServers",
            "groupId",
            "schema"
          ],
          "properties": {
            "bootstrapServers": {
              "type": "string"
            },
            "groupId": {
              "type": "string"
            },
            "topics": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "topicPattern": {
              "type": "string"
            },
            "startupMode": {
              "type": "string",
              "enum": [
                "earliest",
                "latest",
                "committed"
              ]
            },
            "format": {
              "type": "string",
              "enum": [
                "json",
                "cdc-json",
                "raw"
              ]
            },
            "properties": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "schema": {
              "$ref": "#/definitions/SchemaDefinition"
            }
          },
          "oneOf": [
            {
              "required": [
                "topics"
              ]
            },
            {
              "required": [
                "topicPattern"
              ]
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "MysqlCdcSource": {
      "type": "object",
      "required": [
        "type",
        "outputTable",
        "config"
      ],
      "properties": {
        "type": {
          "const": "mysql-cdc"
        },
        "outputTable": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "url",
            "table",
            "username",
            "password"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "table": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "startupMode": {
              "type": "string",
              "enum": [
                "earliest",
                "latest",
                "initial"
              ]
            },
            "serverId": {
              "type": "integer",
              "minimum": 5400,
              "maximum": 15400
            },
            "serverTimeZone": {
              "type": "string"
            },
            "splitKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "MqttSource": {
      "type": "object",
      "required": [
        "type",
        "outputTable",
        "config"
      ],
      "properties": {
        "type": {
          "const": "mqtt"
        },
        "outputTable": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "broker",
            "topic",
            "schema"
          ],
          "properties": {
            "broker": {
              "type": "string"
            },
            "topic": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "schema": {
              "$ref": "#/definitions/SchemaDefinition"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "MockSource": {
      "type": "object",
      "required": [
        "type",
        "outputTable",
        "config"
      ],
      "properties": {
        "type": {
          "const": "mock"
        },
        "outputTable": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "schema"
          ],
          "properties": {
            "schema": {
              "$ref": "#/definitions/SchemaDefinition"
            },
            "data": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "numRows": {
              "type": "integer",
              "minimum": 1
            },
            "intervalMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ModbusSource": {
      "type": "object",
      "required": [
        "type",
        "outputTable",
        "config"
      ],
      "properties": {
        "type": {
          "const": "modbus"
        },
        "outputTable": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "host",
            "address",
            "count"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "deviceId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 247
            },
            "address": {
              "type": "integer",
              "minimum": 0
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "wordSize": {
              "type": "integer",
              "enum": [
                1,
                2
              ]
            },
            "intervalMs": {
              "type": "integer",
              "minimum": 0
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "SourcePlugin": {
      "oneOf": [
        {
          "$ref": "#/definitions/JdbcSource"
        },
        {
          "$ref": "#/definitions/LocalFileSource"
        },
        {
          "$ref": "#/definitions/HttpSource"
        },
        {
          "$ref": "#/definitions/KafkaSource"
        },
        {
          "$ref": "#/definitions/MysqlCdcSource"
        },
        {
          "$ref": "#/definitions/MqttSource"
        },
        {
          "$ref": "#/definitions/MockSource"
        },
        {
          "$ref": "#/definitions/ModbusSource"
        }
      ]
    },

    "TransformPlugin": {
      "type": "object",
      "required": [
        "type",
        "outputTable",
        "config"
      ],
      "properties": {
        "type": {
          "const": "sql"
        },
        "outputTable": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "sql"
          ],
          "properties": {
            "sql": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ConsoleSink": {
      "type": "object",
      "required": [
        "type",
        "inputTable"
      ],
      "properties": {
        "type": {
          "const": "console"
        },
        "inputTable": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "JdbcSink": {
      "type": "object",
      "required": [
        "type",
        "inputTable",
        "config"
      ],
      "properties": {
        "type": {
          "const": "jdbc"
        },
        "inputTable": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "url",
            "username",
            "password"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "dialect": {
              "type": "string",
              "enum": [
                "mysql",
                "postgresql",
                "oracle"
              ]
            },
            "table": {
              "type": "string"
            },
            "sql": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "insert",
                "upsert",
                "cdc",
                "custom"
              ]
            },
            "keyFields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "batchSize": {
              "type": "integer",
              "minimum": 1
            },
            "batchIntervalMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "KafkaSink": {
      "type": "object",
      "required": [
        "type",
        "inputTable",
        "config"
      ],
      "properties": {
        "type": {
          "const": "kafka"
        },
        "inputTable": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "bootstrapServers",
            "topic"
          ],
          "properties": {
            "bootstrapServers": {
              "type": "string"
            },
            "topic": {
              "type": "string"
            },
            "keyField": {
              "type": "string"
            },
            "properties": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "DorisSink": {
      "type": "object",
      "required": [
        "type",
        "inputTable",
        "config"
      ],
      "properties": {
        "type": {
          "const": "doris"
        },
        "inputTable": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "fenodes",
            "table",
            "username",
            "password"
          ],
          "properties": {
            "fenodes": {
              "type": "string"
            },
            "table": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "labelPrefix": {
              "type": "string"
            },
            "batchSize": {
              "type": "integer",
              "minimum": 1
            },
            "batchIntervalMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "SinkPlugin": {
      "oneOf": [
        {
          "$ref": "#/definitions/ConsoleSink"
        },
        {
          "$ref": "#/definitions/JdbcSink"
        },
        {
          "$ref": "#/definitions/KafkaSink"
        },
        {
          "$ref": "#/definitions/DorisSink"
        }
      ]
    }
  }
}
