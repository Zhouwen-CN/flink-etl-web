# 生产环境的环境变量（命名必须以 VITE_ 开头）

## 后端接口地址（如果解决跨域问题采用 CORS 就需要写绝对路径）
VITE_BASE_URL = /etl-platform

## 打包构建静态资源公共路径（例如部署到 https://un-pany.github.io/v3-admin-vite/ 域名下就需要填写 /v3-admin-vite/）
VITE_PUBLIC_PATH = /etl-platform

## springboot admin 和 swagger ui 地址
VITE_SPRINGBOOT_ADMIN_URL = http://127.0.0.1:8080/etl-platform/admin/applications
VITE_SWAGGER_URL = http://127.0.0.1:8080/etl-platform/swagger-ui/index.html
VITE_CONFIG_SCHEMA_URL = http://127.0.0.1:8080/etl-platform/json/schema
